# Backend environment variables
# Copy this file to .env and fill in real values. Never commit .env.

# Logging level for the application package (defaults to INFO when unset)
LOG_LEVEL=DEBUG

# Database — activated when datasource is wired in T3.x / T4.x
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/TaskFlow
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change_me_locally

# CORS — comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Authentication — activated when Spring Security is added
JWT_SECRET=change_me_locally_replace_with_at_least_32_random_characters
