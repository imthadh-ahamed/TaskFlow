# Backend environment variables
# Copy this file to .env and fill in real values. Never commit .env.

# Logging level for the application package (defaults to INFO when unset)
LOG_LEVEL=DEBUG

# Database — activated when datasource is wired in T3.x / T4.x
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/TaskFlow
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change_me_locally

# CORS — comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Authentication — activated in T9.2+. See docs/auth-design-adr.md for full contract.
# JWT_SECRET must be at least 32 random bytes (256 bits) for HS256.
JWT_SECRET=change_me_locally_replace_with_at_least_32_random_characters
# Token lifetimes (optional — defaults shown)
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# Set to false for local HTTP development; must be true in production (enforces Secure cookie flag)
COOKIE_SECURE=false
