<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.example</groupId>
	<artifactId>backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name/>
	<description/>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>21</java.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<!-- Bean Validation (@NotBlank, @Size, etc.) for request DTO validation -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- JDBC + HikariCP connection pool; JPA/Hibernate added in a later phase -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-jdbc</artifactId>
		</dependency>

		<!--
			Spring Cache abstraction + Redis integration.
			spring-boot-starter-cache enables @EnableCaching / @Cacheable.
			spring-boot-starter-data-redis provides LettuceConnectionFactory and
			RedisCacheManager. Redis is optional at runtime: CacheConfig falls back
			to a no-op CacheManager when the Redis connection fails so the
			application stays healthy if Redis is unavailable.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-cache</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis</artifactId>
		</dependency>

		<!-- PostgreSQL JDBC driver — compile scope needed for PGobject in repository code -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
		</dependency>

		<!--
			Spring Boot 4.x extracted FlywayAutoConfiguration into spring-boot-flyway.
			spring-boot-starter-flyway brings in: spring-boot-flyway (auto-config) +
			flyway-core. flyway-database-postgresql is required separately (Flyway 10+).
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>

		<!--
			springdoc-openapi 3.x targets Spring Boot 4.x / Spring Framework 7.x.
			Not managed by Spring Boot BOM — version pinned explicitly.
			Bundles: OpenAPI spec generator + Swagger UI.
			UI: http://localhost:8080/swagger-ui.html
			Spec: http://localhost:8080/v3/api-docs
		-->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>3.1.1</version>
		</dependency>

		<!-- Spring Security — servlet filter chain, BCryptPasswordEncoder -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>

		<!--
			JJWT 0.12.x — JWT creation and validation.
			jjwt-api: compile-time API; jjwt-impl + jjwt-jackson: runtime implementations.
			Not managed by Spring Boot BOM — version pinned explicitly.
		-->
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>0.12.6</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>0.12.6</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>0.12.6</version>
			<scope>runtime</scope>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Provides @WebMvcTest, @SpringBootTest, and spring-boot-test-autoconfigure -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- @WithMockUser and SecurityMockMvcRequestPostProcessors for web-layer tests -->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Actuator — health/readiness endpoints and metrics (T14.1) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!--
			Kafka producer/consumer for async notification event delivery (T13.4).
			Spring Boot 4.x extracted KafkaAutoConfiguration into spring-boot-kafka.
			spring-boot-starter-kafka brings in: spring-boot-kafka (auto-config) +
			spring-kafka. The bare spring-kafka dependency provides the library but
			no auto-configuration, so KafkaTemplate would never be created without
			the starter.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-kafka</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.kafka</groupId>
			<artifactId>spring-kafka</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.kafka</groupId>
			<artifactId>spring-kafka-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>

			<!--
				Include *IT.java classes in the Surefire unit-test run.
				ITs use assumeTrue in @BeforeAll to skip gracefully when PostgreSQL
				is unavailable, so they never fail the build on a machine without a DB.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<includes>
						<include>**/*Test.java</include>
						<include>**/*Tests.java</include>
						<include>**/*IT.java</include>
					</includes>
				</configuration>
			</plugin>

			<!--
				Copy versioned SQL migration files from the database/ component into
				the backend classpath at db/migration/ so Flyway can locate them at
				runtime without requiring a developer-specific filesystem path.
				Source: database/migrations/*.sql (relative to this module)
				Destination: target/classes/db/migration/ (classpath:db/migration)
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
				<executions>
					<execution>
						<id>copy-flyway-migrations</id>
						<phase>process-resources</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.build.outputDirectory}/db/migration</outputDirectory>
							<resources>
								<resource>
									<directory>${project.basedir}/../database/migrations</directory>
									<includes>
										<include>*.sql</include>
									</includes>
								</resource>
							</resources>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
